<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Game_Daily_Routine_Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>res\icon.ico</ApplicationIcon>
    <AssemblyName>MaaaAssistantArknightsAssistant</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="res\icon.png" />
  </ItemGroup>

  <!-- publish 后自动压缩 -->
  <Target Name="ZipAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_Timestamp>$([System.DateTime]::Now.ToString('yyyyMMdd-HHmm'))</_Timestamp>
      <_Rid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_Rid>
      <_Rid Condition="'$(RuntimeIdentifier)' == ''">portable</_Rid>
      <_ZipDir>$(MSBuildProjectDirectory)\bin\Release-Archives</_ZipDir>
      <_ZipName>$(AssemblyName)-$(_Rid)-$(_Timestamp).zip</_ZipName>
    </PropertyGroup>
    <MakeDir Directories="$(_ZipDir)" />
    <Delete Files="$(_ZipDir)\$(_ZipName)" Condition="Exists('$(_ZipDir)\$(_ZipName)')" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_ZipDir)\$(_ZipName)" />
    <Message Importance="high" Text="Published zip: $(_ZipDir)\$(_ZipName)" />
  </Target>

</Project>
