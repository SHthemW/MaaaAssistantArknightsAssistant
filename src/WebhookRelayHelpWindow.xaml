<Window x:Class="Game_Daily_Routine_Launcher.WebhookRelayHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webhook 中转帮助"
        Width="620"
        Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Webhook 中转会在本地端口接收请求，并将请求转发到你配置的目标地址。转发时，url 用于替换原 webhook url，body 用于替换原 webhook body。" TextWrapping="Wrap" Foreground="#212121" />

        <TextBlock Grid.Row="1" Text="转发 URL" Margin="0,16,0,4" FontWeight="SemiBold" />
        <TextBox Grid.Row="2" Text="{Binding ForwardUrl, Mode=OneWay}" IsReadOnly="True" Background="White" />

        <TextBlock Grid.Row="3" Text="转发 Body" Margin="0,12,0,4" FontWeight="SemiBold" />
        <TextBox Grid.Row="4" Text="{Binding ForwardBody, Mode=OneWay}" IsReadOnly="True" Background="White" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
