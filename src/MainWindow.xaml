<Window x:Class="Game_Daily_Routine_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Daily_Routine_Launcher"
        xmlns:views="clr-namespace:Game_Daily_Routine_Launcher.Views"
        mc:Ignorable="d"
        Title="Maaa Assorted Assistant Arranger"
        Icon="/res/icon.ico"
        Width="840"
        MinHeight="700"
        MinWidth="640"
        Background="#FAFAFA"
        SizeToContent="Height"
        WindowStartupLocation="Manual">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="78" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/res/icon.ico" Width="28" Height="28" Margin="0,0,8,0" />
                <TextBlock Text="Maaa Assorted Assistant Arranger" FontSize="18" FontWeight="SemiBold" Foreground="#212121" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="启动全部" Style="{StaticResource ActionButton}" Command="{Binding StartAllCommand}" Margin="0,0,8,0" />
                <Button Content="停止全部" Style="{StaticResource StopButton}" Command="{Binding StopAllCommand}" Margin="0,0,8,0" />
            </StackPanel>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="任务列表" Padding="8">
            <ScrollViewer MinHeight="124"
                          MaxHeight="330"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TaskCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding State, Converter={StaticResource TaskStateToColor}}" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                                <TextBlock Text="{Binding ValidationMessage}" FontSize="11" Foreground="#EF5350" Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding StateText}" Foreground="{Binding State, Converter={StaticResource TaskStateToColor}}" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
                                            <Button Grid.Column="4" Content="启动" Style="{StaticResource SmallButton}" Command="{Binding DataContext.StartSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,4,0" />
                                            <Button Grid.Column="5" Command="{Binding ToggleConfigCommand}" Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                        <Setter Property="Content" Value="配置" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigExpanded}" Value="True">
                                                                <Setter Property="Content" Value="收起" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="6" Content="删除" Style="{StaticResource DangerSmallButton}" Click="OnDeleteTaskClicked" IsEnabled="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <Border Margin="0,8,0,0" Padding="8" Background="#F5F5F5" CornerRadius="4" Visibility="{Binding IsConfigExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="任务名称:" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="工具路径:" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,4,4" />
                                                <Button Grid.Row="1" Grid.Column="2" Content="..." Style="{StaticResource SmallButton}" Command="{Binding BrowseToolPathCommand}" Width="30" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="启动参数:" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ToolArgs, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="监控进程:" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding GameProcessName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="延迟(毫秒):" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DelayBeforeStartMs, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Width="80" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="超时(分钟):" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Width="80" HorizontalAlignment="Left" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource AddTaskCellButton}"
                            Command="{Binding AddTaskCommand}"
                            IsEnabled="{Binding CanEditTasks}"
                            ToolTip="新增任务">
                        <TextBlock Text="+" FontSize="30" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <GroupBox Grid.Row="3" Header="运行日志" Padding="8" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding LogEntries}" x:Name="LogListBox" MinHeight="84" MaxHeight="160" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="White" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" MouseDoubleClick="OnLogListBoxMouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="自动滚动日志" IsChecked="{Binding AutoScrollLogs}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="导出" Style="{StaticResource SmallButton}" Command="{Binding ExportLogsCommand}" Margin="0,0,8,0" />
                        <Button Content="清除" Style="{StaticResource SmallButton}" Command="{Binding ClearLogsCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="防打扰" Padding="8" Margin="0,8,0,0">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="34" />
                    <RowDefinition Height="Auto" MinHeight="34" />
                    <RowDefinition Height="Auto" MinHeight="34" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AntiDisturbPrimary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AntiDisturbSecondary" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Row="0" Grid.Column="0" Content="启动时静音" IsChecked="{Binding MuteOnStart}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <CheckBox Content="仅在自动运行时生效" IsChecked="{Binding MuteOnlyOnAutoRun}" VerticalAlignment="Center" Visibility="{Binding MuteOnStart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <CheckBox Content="运行结束后恢复音量" IsChecked="{Binding RestoreVolumeOnCompletion}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="2" Content="{Binding TestAutoMuteButtonText}" Style="{StaticResource SmallButton}" Command="{Binding TestAutoMuteCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <CheckBox Grid.Row="1" Grid.Column="0" Content="启动时调低亮度" IsChecked="{Binding TwinkleTrayOnStart}" IsEnabled="{Binding TwinkleTrayIsAvailable}" VerticalAlignment="Center" Margin="0,4,12,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,0">
                    <CheckBox Content="仅在自动运行时生效" IsChecked="{Binding TwinkleTrayOnlyOnAutoRun}" IsEnabled="{Binding TwinkleTrayIsAvailable}" VerticalAlignment="Center" Visibility="{Binding TwinkleTrayOnStart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <CheckBox Content="运行结束后恢复亮度" IsChecked="{Binding RestoreBrightnessOnCompletion}" IsEnabled="{Binding TwinkleTrayIsAvailable}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding TestTwinkleTrayButtonText}" Style="{StaticResource SmallButton}" Command="{Binding TestTwinkleTrayCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding TwinkleTrayAvailabilityMessage}" VerticalAlignment="Center" Foreground="#757575" TextWrapping="Wrap" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Grid.Row="2" Grid.Column="0" Content="全部完成后关机" IsChecked="{Binding ShutdownOnComplete}" VerticalAlignment="Center" Margin="0,4,12,0" />
                <CheckBox Grid.Row="2" Grid.Column="1" Content="仅在自动运行时生效" IsChecked="{Binding ShutdownOnlyOnAutoRun}" VerticalAlignment="Center" Margin="0,4,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" />
            </Grid>
        </GroupBox>

        <views:PushSettingsView Grid.Row="5" />

        <GroupBox Grid.Row="6" Header="设置" Padding="8" Margin="0,8,0,0">
            <WrapPanel>
                <TextBlock Text="定时启动时间:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding ScheduledHour, StringFormat={}{0:D2}}" Width="35" Margin="0,0,2,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="时" VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBox Text="{Binding ScheduledMinute, StringFormat={}{0:D2}}" Width="35" Margin="0,0,4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="分" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding ScheduledEndHour, StringFormat={}{0:D2}}" Width="35" Margin="0,0,2,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="时" VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBox Text="{Binding ScheduledEndMinute, StringFormat={}{0:D2}}" Width="35" Margin="0,0,16,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="分" VerticalAlignment="Center" Margin="0,0,16,0" />
                <CheckBox Content="随机时间启动" IsChecked="{Binding RandomStartEnabled}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsSchedulePolling, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Width="8" Height="8" Fill="#FF9800" Margin="0,0,6,0" />
                    <TextBlock Text="轮询中" FontSize="12" Foreground="#757575" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="轮询间隔(秒):" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding PollIntervalSeconds}" Width="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <CheckBox Content="开机自动启动" IsChecked="{Binding AutoRunOnStart}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </WrapPanel>
        </GroupBox>
    </Grid>
    </ScrollViewer>
</Window>
