<Window x:Class="Game_Daily_Routine_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Daily_Routine_Launcher"
        mc:Ignorable="d"
        Title="游戏日常自动化启动器"
        Height="720" Width="640"
        MinHeight="600" MinWidth="520"
        Background="#FAFAFA"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题和操作按钮 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="游戏日常自动化启动器"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="#212121"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="启动全部"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding StartAllCommand}"
                        Margin="0,0,8,0" />
                <Button Content="停止全部"
                        Style="{StaticResource StopButton}"
                        Command="{Binding StopAllCommand}"
                        Margin="0,0,8,0" />
                <Button Content="{Binding IsMuted, Converter={x:Static local:MuteTextConverter.Instance}}"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding ToggleMuteCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- 任务列表 -->
        <GroupBox Grid.Row="1" Header="任务列表" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TaskCard}">
                                <StackPanel>
                                    <!-- 任务主行 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 状态指示灯 -->
                                        <Ellipse Grid.Column="0"
                                                 Width="10" Height="10"
                                                 Margin="0,0,8,0"
                                                 Fill="{Binding State, Converter={StaticResource TaskStateToColor}}" />

                                        <!-- 启用复选框 -->
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding Enabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />

                                        <!-- 任务名称 -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />

                                        <!-- 状态文字 -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding StateText}"
                                                   Foreground="{Binding State, Converter={StaticResource TaskStateToColor}}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />

                                        <!-- 单独启动按钮 -->
                                        <Button Grid.Column="4"
                                                Content="启动"
                                                Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.StartSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,4,0" />

                                        <!-- 配置展开按钮 -->
                                        <Button Grid.Column="5"
                                                Content="配置"
                                                Style="{StaticResource SmallButton}"
                                                Command="{Binding ToggleConfigCommand}" />
                                    </Grid>

                                    <!-- 配置面板 (可展开) -->
                                    <Border Margin="0,8,0,0"
                                            Padding="8"
                                            Background="#F5F5F5"
                                            CornerRadius="4"
                                            Visibility="{Binding IsConfigExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="工具路径:"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,0,4" />
                                            <TextBox Grid.Row="0" Grid.Column="1"
                                                     Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,4,4" />
                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Content="..."
                                                    Style="{StaticResource SmallButton}"
                                                    Command="{Binding BrowseToolPathCommand}"
                                                    Width="30"
                                                    Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="启动参数:"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,0,4" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding ToolArgs, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="监控进程:"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,0,4" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding GameProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="3" Grid.Column="0"
                                                       Text="延迟(毫秒):"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding DelayBeforeStartMs, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="80"
                                                     HorizontalAlignment="Left" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- 分隔 -->
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- 运行日志 -->
        <GroupBox Grid.Row="3" Header="运行日志" Padding="8" Margin="0,4,0,0">
            <ListBox ItemsSource="{Binding LogEntries}"
                     x:Name="LogListBox"
                     FontFamily="Consolas"
                     FontSize="12"
                     BorderThickness="0"
                     Background="White">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="Foreground" Value="#424242" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </GroupBox>

        <!-- 选项 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox Content="全部完成后关机"
                      IsChecked="{Binding ShutdownOnComplete}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0" />
            <CheckBox Content="注册开机自启"
                      IsChecked="{Binding AutoRunOnStart}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0" />
            <CheckBox Content="启动时静音"
                      IsChecked="{Binding MuteOnStart}"
                      VerticalAlignment="Center" />
        </StackPanel>

        <!-- 设置 -->
        <GroupBox Grid.Row="5" Header="设置" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="定时启动时间:"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <TextBox Text="{Binding ScheduledHour}"
                         Width="35" Margin="0,0,2,0"
                         HorizontalContentAlignment="Center" />
                <TextBlock Text=":" VerticalAlignment="Center" />
                <TextBox Text="{Binding ScheduledMinute}"
                         Width="35" Margin="2,0,16,0"
                         HorizontalContentAlignment="Center" />

                <TextBlock Text="轮询间隔(秒):"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <TextBox Text="{Binding PollIntervalSeconds}"
                         Width="50" Margin="0,0,16,0"
                         HorizontalContentAlignment="Center" />

                <Button Content="保存配置"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding SaveConfigCommand}" />
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
