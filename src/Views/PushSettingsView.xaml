<UserControl x:Class="Game_Daily_Routine_Launcher.Views.PushSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Game_Daily_Routine_Launcher.Views">
    <GroupBox Header="推送" Padding="8" Margin="0,8,0,0">
        <StackPanel>
            <StackPanel Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="启用 Webhook 推送" IsChecked="{Binding WebhookEnabled}" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource CollapseToggleButtonStyle}"
                                  IsChecked="{Binding WebhookEnabledExpanded}"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding WebhookEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <StackPanel Margin="24,8,0,0" Visibility="{Binding WebhookEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding WebhookEnabledExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WebhookUrl, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="内容:" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WebhookBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="测试" Style="{StaticResource SmallButton}" Command="{Binding TestWebhookCommand}" HorizontalAlignment="Left" />
                        </Grid>
                        <CheckBox Content="自定义要推送的内容"
                                  IsChecked="{Binding WebhookCustomPushContentEnabled}"
                                  VerticalAlignment="Center"
                                  Margin="0,12,0,0" />
                        <StackPanel Margin="24,8,0,0" Visibility="{Binding WebhookCustomPushContentEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding WebhookPushContentOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsEnabled}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,16,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <CheckBox Content="启用 Webhook 中转" IsChecked="{Binding WebhookRelayEnabled}" VerticalAlignment="Center" />
                        <Button ToolTip="帮助"
                                Width="16"
                                Height="16"
                                Padding="0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Click="OnWebhookRelayHelpClicked"
                                Background="#F5F5F5"
                                BorderBrush="#D0D0D0"
                                Foreground="#757575">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Content>
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource CollapseToggleButtonStyle}"
                                  IsChecked="{Binding WebhookRelayExpanded}"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding WebhookRelayEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <StackPanel Margin="24,8,0,0" Visibility="{Binding WebhookRelayEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding WebhookRelayExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="端口:" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding WebhookRelayPort, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding WebhookRelayStatusMessage}" VerticalAlignment="Center" Foreground="#757575" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="原URL:" VerticalAlignment="Center" Margin="0,4,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WebhookRelaySourceUrl, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <views:AiSummarySettingsView />
        </StackPanel>
    </GroupBox>
</UserControl>
